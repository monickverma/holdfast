{
  "name": "holdfast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous HSKSwap trading agent inside a contract-enforced loss limit",
  "scripts": {
    "test:contracts": "node scripts/forge.mjs test -vv",
    "test:agent": "node --import tsx --test agent/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "e2e:fork": "tsx agent/test/e2e-fork.ts",
    "agent": "tsx agent/src/main.ts",
    "preflight": "tsx agent/src/cli/preflight.ts",
    "swap:once": "tsx agent/src/cli/swap-once.ts",
    "admin": "tsx agent/src/cli/admin.ts",
    "setup": "tsx agent/src/cli/setup.ts",
    "bench:swaps": "tsx agent/src/cli/bench-swaps.ts",
    "bench:read": "tsx agent/src/cli/bench-read.ts",
    "bench:react": "tsx agent/src/cli/bench-react.ts",
    "bench:inclusion": "tsx agent/src/cli/bench-inclusion.ts",
    "check:quotes": "tsx agent/src/cli/check-quotes.ts",
    "bench:cold": "tsx agent/src/cli/bench-cold.ts",
    "bench:route": "tsx agent/src/cli/bench-route.ts",
    "bench:limit": "tsx agent/src/cli/bench-limit.ts",
    "replay:edge": "tsx agent/src/cli/replay-edge.ts",
    "replay:strategy": "npm run build:agent && node .test-build/src/cli/replay-strategy.js",
    "shadow": "tsx agent/src/cli/shadow.ts",
    "frame-drift": "tsx agent/src/cli/frame-drift.ts",
    "bench:gas": "node scripts/forge.mjs build --offline && npm run build:agent && node .test-build/test/bench-gas.js",
    "report": "tsx agent/src/cli/report.ts",
    "attack-set": "tsx agent/test/attack-set.ts",
    "rehearse": "node scripts/forge.mjs build --offline && npm run build:agent && node .test-build/test/rehearsal.js",
    "refusals": "tsx agent/src/cli/refusals.ts",
    "viewer": "tsx agent/src/cli/viewer.ts",
    "monitor": "tsx agent/src/cli/monitor.ts",
    "keeper": "tsx agent/src/cli/keeper.ts",
    "audit": "tsx agent/src/cli/audit.ts",
    "verify:history": "npm run -s build:agent && node .test-build/agent/src/cli/verify-history.js",
    "export:records": "npm run -s build:agent && node .test-build/agent/src/cli/export-records.js",
    "deploy:vault": "node scripts/forge.mjs build --offline && npm run build:agent && node .test-build/src/cli/deploy-vault.js",
    "verify:explorer": "node scripts/explorer-verify.mjs",
    "mcp": "tsx agent/src/cli/mcp-server.ts",
    "llm:live": "tsx agent/src/cli/llm-live.ts",
    "check:mutation": "node scripts/mutation-check.mjs",
    "check:slither": "node scripts/slither-check.mjs",
    "check:transactions": "node scripts/check-public-transactions.mjs",
    "verify:record": "node scripts/record-verification.mjs",
    "e2e:testmarket": "node scripts/forge.mjs build --offline && npm run build:agent && node .test-build/test/e2e-testmarket.js",
    "deploy:testmarket": "node scripts/forge.mjs build --offline && npm run build:agent && node .test-build/src/cli/deploy-test-market.js",
    "build:agent": "tsc --noEmit false --rootDir agent --outDir .test-build",
    "test:agent:local": "npm run build:agent && node --test --test-isolation=none .test-build/test/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
