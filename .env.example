# Copy to .env and fill in yourself. .env is gitignored. Never paste keys into a chat or a commit.

# Your wallet that deploys and owns the vault. It can withdraw, so keep it safe.
OWNER_PRIVATE_KEY=

# A separate, new wallet for the agent. Fund it with gas only. It cannot withdraw from the vault.
AGENT_PRIVATE_KEY=

# Printed by `npm run admin -- deploy --broadcast`.
VAULT_ADDRESS=

# Real transactions go out only when this is true. Leave false to observe.
LIVE=false

# For the plain-English prompt. The trading loop runs without it.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# Optional overrides.
# RPC_URL=https://mainnet.hsk.xyz
# POLL_MS=650
