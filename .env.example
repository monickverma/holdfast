# Copy to .env and fill in yourself. .env is gitignored. Never paste keys into a chat or a commit.

# Your wallet that deploys and owns the vault. It can withdraw, so keep it safe.
OWNER_PRIVATE_KEY=

# A separate, new wallet for the agent. Fund it with gas only. It cannot withdraw from the vault.
AGENT_PRIVATE_KEY=

# Printed by `npm run admin -- deploy --broadcast`.
VAULT_ADDRESS=

# Set this to 3 for a vault deployed from the current contract. It has a price guard and a daily budget to read.
VAULT_GENERATION=3

# observe reads and decides. simulate also asks the vault by eth_call, and needs no key. live sends transactions.
# LIVE=true is the older spelling of MODE=live.
MODE=observe

# Asks the vault by eth_call before signing a trade from a sealed block, so a refusal costs no gas. On by default.
# PREFLIGHT=true

# A key holding only gas, for `npm run keeper -- --broadcast`. It can fire an armed stop and nothing else.
# KEEPER_PRIVATE_KEY=

# For the plain-English prompt and `npm run llm:live`. The trading loop runs without it.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# Optional overrides.
# RPC_URL=https://mainnet.hsk.xyz
# POLL_MS=650

# Viewer chat costs money per answer. Off this machine a caller must send this token; leave it unset on a public site.
CHAT_TOKEN=
CHAT_DAILY_LIMIT=200
